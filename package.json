{
  "name": "vexorionerp-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "VexorionERP.UI",
    "VexorionERP.AdminUI",
    "VexorionERP.POS",
    "VexorionERP.LandingPage",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "node scripts/run-frontend-tests.mjs",
    "test:run": "node scripts/run-frontend-tests.mjs",
    "frontend:config:check": "node scripts/validate-frontend-dev-config.mjs",
    "e2e:lifecycle:test": "node --test scripts/e2e/tenant-lifecycle.test.mjs",
    "preview": "turbo run preview",
    "ui:version": "node scripts/bump-ui-version.mjs",
    "ui:version:patch": "node scripts/bump-ui-version.mjs patch",
    "ui:version:minor": "node scripts/bump-ui-version.mjs minor",
    "ui:version:major": "node scripts/bump-ui-version.mjs major",
    "ui:aliases:sync": "npm run aliases:sync -w @vexorion/ui"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "turbo": "^2.1.3"
  }
}
