{
  "name": "vexorionerp-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "VexorionERP.UI",
    "VexorionERP.AdminUI",
    "VexorionERP.POS",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
