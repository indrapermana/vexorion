    "@tanstack/react-query": "^5.100.5",
    "axios": "^1.15.0",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^26.0.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.73.1",
    "react-i18next": "^17.0.4",
    "react-router-dom": "^7.14.1",
    "yup": "^1.7.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
