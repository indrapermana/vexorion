{
  "Cors": {
    "AllowedOrigins": [
      "https://app.vexorionerp.com",
      "https://admin.vexorionerp.com",
      "https://pos.vexorionerp.com"
    ]
  },
  "Caching": {
    "MemoryCacheEntryLimit": 1024
  },
  "Jwt": {
    "Issuer": "VexorionERP",
    "Audience": "VexorionERP.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Bootstrap": {
    "Tenant": {
      "Name": "VexorionERP",
      "Code": "vexorionerp"
    },
    "Company": {
      "Name": "PT INDESYA KARYA DIGITAL",
      "Code": "MAIN"
    },
    "AdminUser": {
      "UserName": "admin",
      "Email": "admin@vexorion.local",
      "FirstName": "System",
      "LastName": "Administrator"
    }
  },
  "TenantGovernanceDefaults": {
    "CreateDefaultsOnTenantOnboarding": true,
    "Modules": {
      "ProjectManagementEnabled": true,
      "DocumentManagementEnabled": true,
      "EmployeeManagementEnabled": true,
      "SalesEnabled": true,
      "PurchasingEnabled": true,
      "InventoryEnabled": true
    },
    "Plan": {
      "PlanCode": "STARTER",
      "PlanName": "Starter",
      "MaxStorageBytes": 5368709120,
      "MaxFileSizeBytes": 104857600,
      "WarningThresholdPercent": 80,
      "SoftBlockThresholdPercent": 95,
      "HardBlockThresholdPercent": 100
    }
  },
  "TenantModuleRollout": {
    "Enabled": false,
    "Project": {
      "Enabled": false,
      "Mode": "AllowAll",
      "AllowedTenantIds": [],
      "AllowedTenantCodes": []
    },
    "Document": {
      "Enabled": false,
      "Mode": "AllowAll",
      "AllowedTenantIds": [],
      "AllowedTenantCodes": []
    },
    "Employee": {
      "Enabled": false,
      "Mode": "AllowAll",
      "AllowedTenantIds": [],
      "AllowedTenantCodes": []
    }
  },
  "AzureBlob": {
    "ContainerName": "product-images"
  },
  "Storage": {
    "Provider": "AzureBlob",
    "R2": {
      "SignedUrlLifetimeMinutes": 5
    }
  },
  "Imports": {
    "MaxFileSizeMb": 10
  },
  "DocumentSecurity": {
    "AbsoluteMaxFileSizeBytes": 104857600,
    "RequireMalwareScan": false,
    "ClamAv": {
      "Enabled": false,
      "Host": "localhost",
      "Port": 3310,
      "TimeoutSeconds": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "ResendApiKey": "",
    "FromAddress": "",
    "FromName": "Vexorion",
    "MainUiBaseUrl": "",
    "PasswordResetMinutes": 15,
    "RedirectPlusAddressing": false
  },
  "GrafanaLoki": {
    "Url": "https://logs-prod-020.grafana.net"
  }
}
